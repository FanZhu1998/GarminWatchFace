<fonts xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!--
        Bitmap fonts generated from Libre Franklin and IBM Plex Mono (both SIL OFL) with tools/FontGen.java.
        Sizes are tuned for legibility on the 1.3in / 416 px epix Pro screen.
        Every character the face ever draws must be in the filter, or it renders blank.
    -->
    <font id="LF_Light_112" filename="lf_light_112.fnt" filter="0123456789:"      antialias="true"/>
    <font id="LF_Semi_42"   filename="lf_semi_42.fnt"   filter="0123456789,.%-K"  antialias="true"/>
    <font id="Mono_30"      filename="plex_30.fnt"      filter="0123456789"       antialias="true"/>
    <font id="Mono_26"      filename="plex_26.fnt"      filter="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:.%-·— " antialias="true"/>
    <font id="Mono_22"      filename="plex_22.fnt"      filter="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:.%-·— " antialias="true"/>
</fonts>
